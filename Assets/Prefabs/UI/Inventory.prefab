  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Trong qu\xE1 tr\xECnh ph\xE1t tri\u1EC3n game, vi\u1EC7c t\xE1i s\u1EED
    d\u1EE5ng c\xE1c th\xE0nh ph\u1EA7n l\xE0 m\u1ED9t ph\u1EA7n quan tr\u1ECDng
    \u0111\u1EC3 t\u0103ng hi\u1EC7u su\u1EA5t v\xE0 ti\u1EBFt ki\u1EC7m th\u1EDDi
    gian. Tr\xEAn Unity, Prefab l\xE0 m\u1ED9t trong nh\u1EEFng c\xF4ng c\u1EE5 quan
    tr\u1ECDng cho vi\u1EC7c n\xE0y.\r\n\r\nKhi t\xF4i ho\xE0n th\xE0nh vi\u1EC7c
    thi\u1EBFt k\u1EBF m\u1ED9t Prefab \u0111\u1EB7c bi\u1EC7t trong d\u1EF1 \xE1n
    hi\u1EC7n t\u1EA1i c\u1EE7a m\xECnh, t\xF4i mu\u1ED1n mang n\xF3 sang d\u1EF1
    \xE1n m\u1EDBi \u0111\u1EC3 s\u1EED d\u1EE5ng l\u1EA1i m\xE0 kh\xF4ng c\u1EA7n
    ph\u1EA3i t\u1EA1o l\u1EA1i t\u1EEB \u0111\u1EA7u. \u0110\u1EA7u ti\xEAn, t\xF4i
    sao ch\xE9p Prefab v\xE0 t\u1EA5t c\u1EA3 c\xE1c t\xE0i nguy\xEAn li\xEAn quan
    t\u1EEB th\u01B0 m\u1EE5c Assets c\u1EE7a d\u1EF1 \xE1n hi\u1EC7n t\u1EA1i. Sau
    \u0111\xF3, t\xF4i m\u1EDF d\u1EF1 \xE1n m\u1EDBi v\xE0 d\xE1n Prefab c\xF9ng
    v\u1EDBi c\xE1c t\xE0i nguy\xEAn v\xE0o th\u01B0 m\u1EE5c Assets c\u1EE7a d\u1EF1
    \xE1n m\u1EDBi."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
