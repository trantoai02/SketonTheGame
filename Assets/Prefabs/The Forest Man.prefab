          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 6255434299973242221}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
      - m_Target: {fileID: 6255434300112971599}
        m_TargetAssemblyTypeName: AnimatorTriggerInvoker, Assembly-CSharp
        m_MethodName: SetBoolTrue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: isGlow
          m_BoolArgument: 1
        m_CallState: 2
      - m_Target: {fileID: 6255434299973242223}
        m_TargetAssemblyTypeName: DialogueTrigger, Assembly-CSharp
        m_MethodName: TriggerDialogue
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  dialogueList:
    dialogues:
    - name: "Th\u1EA7n R\u1EEBng"
      lines:
      - "\xD4 h\xF4 h\xF4\u2026\r\nC\u1EADu b\xE9 \u0111\xE3 t\u1EC9nh d\u1EADy r\u1ED3i
        \u0111\u1EA5y \xE0!\r"
      - "Th\u1EADt k\u1EF3 l\u1EA1, con l\xE0 1 m\u1ED9t c\u1EADu b\xE9 lo\xE0i ng\u01B0\u1EDDi
        \u0111\u01B0\u1EE3c sinh ra t\u1EEB 1 qu\u1EA3 tr\u1EE9ng, m\u1ED9t hi\u1EC7n
        t\u01B0\u1EE3ng m\xE0 ta ch\u01B0a t\u1EEBng nh\xECn th\u1EA5y bao gi\u1EDD. "
      - "R\u1ED3i sau \u0111\xF3 con \u0111\xE3 b\u1ECB b\u1ECDn qu\xE1i v\u1EADt
        t\u1EA5n c\xF4ng? Ch\xFAng n\xF3 mu\u1ED1n \u0103n th\u1ECBt m\u1ED9t c\u1EADu
        b\xE9 ch\u1EC9 v\u1EEBa m\u1EDBi sinh ra \u0111\u1EDDi!? "
      - "Th\u1EADt kh\u1ED1n kh\u1ED5 kh\u1ED1n n\u1EA1n l\xE0m sao, c\xE1i l\u0169\u2026c\xE1i
        l\u0169 qu\xE1i v\u1EADt \u1EA5y! "
    - name: Krixim
      lines:
      - "{playerName}, \u0111\xF3 l\xE0 Th\u1EA7n R\u1EEBng!"
      - "\xD4ng \u1EA5y cung c\u1EA5p n\u0103ng l\u01B0\u1EE3ng \u0111\u1EC3 nu\xF4i
        d\u01B0\u1EE1ng khu r\u1EEBng, \xF4ng \u1EA5y l\xE0 ng\u01B0\u1EDDi b\u1EA3o
        v\u1EC7 khu r\u1EEBng, "
      - "l\xE0 ng\u01B0\u1EDDi b\u1EA3o v\u1EC7 ch\xFAng ta tr\u01B0\u1EDBc b\u1ECDn
        qu\xE1i v\u1EADt m\xE0 b\u1EA1n \u0111\xE3 g\u1EB7p h\xF4m qua \u0111\xF3. "
    - name: "Th\u1EA7n R\u1EEBng"
      lines:
      - "N\xE0y Krixim, con \u0111\u1EEBng n\xF3i nh\u01B0 th\u1EC3 ta l\xE0 m\u1ED9t
        v\u1ECB th\u1EA7n, ta ch\u1EC9 l\xE0m nh\u1EEFng vi\u1EC7c m\xE0 ta n\xEAn
        l\xE0m. "
      - "L\u1EBD ra ta kh\xF4ng n\xEAn can thi\u1EC7p v\xE0o d\xF2ng ch\u1EA3y t\u1EF1
        nhi\xEAn c\u1EE7a h\u1EC7 sinh th\xE1i trong khu r\u1EEBng, nh\u01B0 tr\u01B0\u1EDBc
        \u0111\xE2y ta \u0111\xE3 t\u1EEBng. "
      - "Nh\u01B0ng khu r\u1EEBng gi\u1EDD \u0111\xE2y \u0111ang g\xE1nh ch\u1ECBu
        s\u1EF1 m\u1EA5t c\xE2n b\u1EB1ng nghi\xEAm tr\u1ECDng v\xEC b\u1ECDn sinh
        v\u1EADt ngo\u1EA1i lai, "
      - "v\xEC l\u0169 qu\u1EF9 \u0111\u1EBFn t\u1EEB \u0111\u1ECBa ng\u1EE5c m\xE0
        n\u1EBFu ta kh\xF4ng can thi\u1EC7p, c\u1EA3 khu r\u1EEBng kh\xF4ng s\u1EDBm
        th\xEC mu\u1ED9n s\u1EBD b\u1ECB thi\xEAu r\u1EE5i."
    - name: Krixim
      lines:
      - "\xD4ng n\xF3i nh\u01B0 v\u1EADy, th\xEC con c\u0169ng kh\xF4ng th\u1EC3
        n\xF3i g\xEC th\xEAm n\u1EEFa, c\u0169ng kh\xF4ng th\u1EC3 n\xF3i kh\xE1c
        \u0111i, \xF4ng \u0111\xFAng l\xE0 m\u1ED9t V\u1ECB Th\u1EA7n B\u1EA3o V\u1EC7
        Khu R\u1EEBng."
    - name: "Th\u1EA7n R\u1EEBng"
      lines:
      - "N\xE0y Krixim, chi\u1EBFc m\u0169i g\u1ED7 c\u1EE7a ta \u0111\xE3 b\u1EAFt
        \u0111\u1EA7u b\u1ED1c l\u1EEDa r\u1ED3i \u0111\xE2y n\xE0y. "
      - 'Ahaha!!! '
      - "Sketon, b\xE2y gi\u1EDD con c\xF3 th\u1EC3 y\xEAn t\xE2m khi \u1EDF \u0111\xE2y
        b\xEAn c\u1EA1nh ta, b\u1ECDn qu\u1EF9 s\u1EBD kh\xF4ng th\u1EC3 \u0111\u1EBFn
        \u0111\u01B0\u1EE3c n\u01A1i n\xE0y, trong ph\u1EA1m vi m\xE0 ta \u0111ang
        b\u1EA3o v\u1EC7\u2026 "
    - name: Krixim
      lines:
      - "\xD4ng R\u1EEBng \u1EA1, b\u1ECDn qu\xE1i v\u1EADt c\xF3 th\u1EC3 \u0111\xE3
        \u0111\xF4ng h\u01A1n r\u1EA5t nhi\u1EC1u, \u0111\xEAm qua con ph\u1EA3i
        ch\u1EADt v\u1EADt l\u1EAFm m\u1EDBi c\xF3 th\u1EC3 gi\u1EA3i c\u1EE9u Sketon
        v\xE0 tho\xE1t th\xE2n, "
      - "nh\u01B0ng Draff\u2026\r\n\xD4i, con v\u1EABn ch\u01B0a t\xECm th\u1EA5y
        Draff.\r\n"
      - "B\xE2y gi\u1EDD t\xECnh tr\u1EA1ng c\u1EE7a Draff nh\u01B0 th\u1EBF n\xE0o
        r\u1ED3i \xF4ng \u1EA1?"
  talkButton: {fileID: 6255434298971448645}
  dialogueDelay: 0
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 0}
