      propertyPath: dialogueList.dialogues.Array.data[0].name
      value: "Anh n\xF4ng d\xE2n"
      objectReference: {fileID: 0}
    - target: {fileID: 7981537499525796056, guid: 3f8c1796f1e3f0a4ab5550648b390a78, type: 3}
