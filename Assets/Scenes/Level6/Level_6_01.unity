  dialogueList:
    dialogues:
    - name: "Ng\u01B0\u1EDDi L\xEDnh 1"
      lines:
      - 'Ahap!

'
      - "\xCA!!!\n"
      - "\u0110\u1EE9ng l\u1EE3i!"
      - "Con nh\xE0 ai m\xE0 m\u1EB7t l\u1EA1 th\u1EBF?"
    - name: "Ng\u01B0\u1EDDi L\xEDnh 2"
      lines:
      - "Nh\xECn b\u1ED9 d\u1EA1ng ngh\xE8o r\xE1ch th\u1EBF kia m\xE0 d\xE1m m\xF2
        t\u1EDBi c\u1ED5ng th\xE0nh \xE0? C\xF3 gi\u1EA5y th\xF4ng h\xE0nh kh\xF4ng?\n"
      - "C\xE1i g\xEC? Kh\xF4ng c\xF3 \xE1!!?\n"
      - "C\xE1i g\xEC? Ki\u1EBFm \xE1?"
    - name: "Ng\u01B0\u1EDDi L\xEDnh 1"
      lines:
      - "N\xF3 n\xF3i c\xE1i g\xEC th\u1EBF?"
    - name: "Ng\u01B0\u1EDDi L\xEDnh 2"
      lines:
      - "N\xF3 n\xF3i mu\u1ED1n t\xECm thanh ki\u1EBFm \u0111\xF3"
      - "Nh\xF3c mu\u1ED1n t\xECm thanh ki\u1EBFm \u0111\xF3 \u0111\u1EC3 l\xE0m
        g\xEC? kh\xF4ng ph\u1EA3i \u0111\u1ED3 ch\u01A1i \u0111\xE2u nh\xE9!"
    - name: "Ng\u01B0\u1EDDi L\xEDnh 1"
      lines:
      - "Th\xF4i k\u1EC7 n\xF3, con n\xEDt m\xE0"
      - "Cho n\xF3 v\xE0o \u0111i!"
      - "X\xF9 x\xEC x\xF9 x\xEC "
      - ...
      - "Cho nh\xF3c v\xE0o \u0111\u1EA5y!"
  talkButton: {fileID: 0}
  dialogueDelay: 0
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 0}
