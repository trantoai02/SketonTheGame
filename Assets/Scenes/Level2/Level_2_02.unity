    dialogues:
    - name: Krixim
      lines:
      - "\u1ED0i!!! C\xE0nh c\xE2y b\u1ECB g\xE3y v\xE0 r\u01A1i xu\u1ED1ng \u0111\u1EA5t,"
      - "b\xEAn trong l\xE0 m\u1ED9t ch\xFA s\xF3c nh\u1ECF \u0111ang ho\u1EA3ng
