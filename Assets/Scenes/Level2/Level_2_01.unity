          m_BoolArgument: 1
        m_CallState: 2
      - m_Target: {fileID: 1139893519}
        m_TargetAssemblyTypeName: AnimatorTriggerInvoker, Assembly-CSharp
        m_MethodName: SetBoolTrue
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
