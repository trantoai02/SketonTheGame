    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[0].lines.Array.data[0]
      value: "\xD4 h\xF4 h\xF4\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[0].lines.Array.data[1]
      value: "C\u1EADu b\xE9 \u0111\xE3 .t\u1EC9nh d\u1EADy r\u1ED3i \u0111\u1EA5y
        \xE0!"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[0].lines.Array.data[2]
      value: "Th\u1EADt k\u1EF3 l\u1EA1, con l\xE0 1 m\u1ED9t c\u1EADu b\xE9 lo\xE0i
        ng\u01B0\u1EDDi \u0111\u01B0\u1EE3c sinh ra t\u1EEB 1 qu\u1EA3 tr\u1EE9ng,"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[0].lines.Array.data[3]
      value: "m\u1ED9t hi\u1EC7n t\u01B0\u1EE3ng m\xE0 ta ch\u01B0a t\u1EEBng nh\xECn
        th\u1EA5y bao gi\u1EDD."
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[0].lines.Array.data[4]
      value: "R\u1ED3i sau \u0111\xF3 con \u0111\xE3 b\u1ECB b\u1ECDn qu\xE1i v\u1EADt
        t\u1EA5n c\xF4ng? Ch\xFAng n\xF3 mu\u1ED1n \u0103n th\u1ECBt m\u1ED9t c\u1EADu
        b\xE9 ch\u1EC9 v\u1EEBa m\u1EDBi sinh ra \u0111\u1EDDi!?"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[0].lines.Array.data[5]
      value: "Th\u1EADt kh\u1ED1n kh\u1ED5 kh\u1ED1n n\u1EA1n l\xE0m sao, c\xE1i
        l\u0169\u2026c\xE1i l\u0169 qu\xE1i v\u1EADt \u1EA5y! "
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[1].lines.Array.data[2]
      value: "V\xE0 t\u1EA5t nhi\xEAn, \u0111\u1EC3 \u0111\u1ED1i ph\xF3 v\u1EDBi
        t\xEAn th\u1EA7n ch\u1EBFt n\xE0y, CON PH\u1EA2I CHU\u1EA8N B\u1ECA!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[1].lines.Array.data[3]
      value: "V\xE0 t\u1EA5t nhi\xEAn, \u0111\u1EC3 \u0111\u1ED1i ph\xF3 v\u1EDBi
        t\xEAn th\u1EA7n ch\u1EBFt n\xE0y, CON PH\u1EA2I CHU\u1EA8N B\u1ECA!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[2].lines.Array.data[0]
      value: "Sketon, nh\u1EEFng \u0111o\u1EA1n \u0111\u01B0\u1EDDng ph\xEDa tr\u01B0\u1EDBc
        s\u1EBD l\u1EAFm ch\xF4ng gai"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[2].lines.Array.data[1]
      value: "V\xE0 t\u1EA5t nhi\xEAn, \u0111\u1EC3 \u0111\u1ED1i ph\xF3 v\u1EDBi
        t\xEAn th\u1EA7n ch\u1EBFt n\xE0y, CON PH\u1EA2I CHU\u1EA8N B\u1ECA!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 4930844580132963878, guid: 4f735c95e4f4ce14e88d77b6cf26d1dd, type: 3}
      propertyPath: dialogueList.dialogues.Array.data[2].lines.Array.data[2]
      value: "V\xE0 t\u1EA5t nhi\xEAn, \u0111\u1EC3 \u0111\u1ED1i ph\xF3 v\u1EDBi
        t\xEAn th\u1EA7n ch\u1EBFt n\xE0y, CON PH\u1EA2I CHU\u1EA8N B\u1ECA!!!"
