          m_StringArgument: lv2_quest1
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 1068488583}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  dialogueList:
    dialogues:
    - name: "Th\u1EA7n R\u1EEBng "
      lines:
      - "T\xECm th\u1EA5y r\u1ED3i, Draff \u0111ang b\u1ECB b\u1ECDn qu\xE1i v\u1EADt
        v\xE2y h\xE3m \u1EDF c\xE2y s\u1ED3i c\u1EA1nh b\u1EDD s\xF4ng khu r\u1EEBng
        ph\xEDa \u0110\xF4ng."
    - name: Krixim
      lines:
      - "\xD4i kh\xF4ng, b\u1EA1n \u1EA5y \u0111ang \u1EDF trong t\xECnh hu\u1ED1ng
        nguy hi\u1EC3m. Con ph\u1EA3i \u0111\u1EBFn c\u1EE9u b\u1EA1n \u1EA5y ngay."
    - name: "Th\u1EA7n R\u1EEBng "
      lines:
      - "Khoan \u0111\xE3 Krixim, b\u1ECDn ch\xFAng r\u1EA5t \u0111\xF4ng, v\u1EDBi
        s\u1EE9c c\u1EE7a con hi\u1EC7n gi\u1EDD, ta e r\u1EB1ng\u2026"
    - name: Sketon
      lines:
      - "M\xECnh\u2026@# !!"
    - name: Krixim
      lines:
      - '!!!'
    - name: "Th\u1EA7n R\u1EEBng "
      lines:
      - '!!!'
    - name: Krixim
      lines:
      - "Sketon, b\u1EA1n n\xF3i, l\xE0 b\u1EA1n mu\u1ED1n gi\xFAp m\xECnh sao?"
    - name: Sketon
      lines:
      - "M\xECnh mu\u1ED1n gi\xFAp!"
    - name: Krixim
      lines:
      - "Hihihi! Xem ra c\xF3 ng\u01B0\u1EDDi c\u1EA7n ph\u1EA3i trau d\u1ED3i th\xEAm
        v\u1ED1n t\u1EEB v\u1EF1ng r\u1ED3i \u0111\xF3!"
  talkButton: {fileID: 67806981}
  dialogueDelay: 2
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 0}
