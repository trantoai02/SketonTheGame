  m_Name: 
  m_EditorClassIdentifier: 
  eventBeforeTriggerDialogue:
    m_PersistentCalls:
      m_Calls: []
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 118142957}
        m_TargetAssemblyTypeName: QuestManager, Assembly-CSharp
        m_MethodName: CompleteQuest
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
