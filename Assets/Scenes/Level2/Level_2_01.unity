    m_PersistentCalls:
      m_Calls: []
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
  dialogueList:
    dialogues:
    - name: Krixim
      lines:
      - "\u1ED0i, Cha Gi\xE0 \u01A1i, b\u1EA1n \u1EA5y \u0111\xE3 t\u1EC9nh d\u1EADy!"
      - "Sketon, b\u1EA1n \u0111\xE3 t\u1EC9nh r\u1ED3i \u0111\u1EA5y \xE0? Th\u1EADt
        may m\u1EAFn v\xEC t\u1EDB \u0111\xE3 b\u1EAFt g\u1EB7p b\u1EA1n \u1EDF b\xECa
        r\u1EEBng, kh\xF4ng th\xEC l\u0169 qu\xE1i v\u1EADt \u0111\xE3... "
      - "B\xE2y gi\u1EDD b\u1EA1n c\u1EA3m th\u1EA5y th\u1EBF n\xE0o r\u1ED3i?"
      - "\xC0, Sketon.. l\xE0 t\xEAn t\u1EDB \u0111\u1EB7t cho b\u1EA1n \u0111\u1EA5y,
        b\u1EA1n th\xEDch ch\u1EE9?"
  talkButton: {fileID: 0}
  dialogueDelay: 0
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 0}
