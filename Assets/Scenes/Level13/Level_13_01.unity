--- !u!114 &7981537498437461388
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7981537498437461386}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d3c5e169fdd9de4aa7a43fe96442e99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eventBeforeTriggerDialogue:
    m_PersistentCalls:
      m_Calls: []
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
  dialogueList:
    dialogues:
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Sketon! N\u1EBFu gi\u1EBFt ta, ng\u01B0\u01A1i s\u1EBD kh\xF4ng g\u1EB7p
        \u0111\u01B0\u1EE3c b\u1EA1n c\u1EE7a ng\u01B0\u01A1i \u0111\u01B0\u1EE3c
        n\u1EEFa! "
      - "N\u1EBFu gi\u1EBFt ta, \u0111\u1ECBa ng\u1EE5c n\xE0y kh\xF4ng c\xF3 ai
        cai tr\u1ECB, ng\u01B0\u01A1i s\u1EBD ch\u1ECBu l\u1EDDi nguy\u1EC1n kh\xF4ng
        th\u1EC3 ch\u1ED1ng l\u1EA1i \u0111\u01B0\u1EE3c,"
      - "ng\u01B0\u01A1i s\u1EBD bi\u1EBFn th\xE0nh Th\u1EA7n Ch\u1EBFt ti\u1EBFp
        theo, thay th\u1EBF v\u1ECB tr\xED c\u1EE7a ta, ti\u1EBFp qu\u1EA3n n\u01A1i
        n\xE0y!"
      - "\xCDt ra ng\u01B0\u01A1i ph\u1EA3i ch\u1EBFt tr\u01B0\u1EDBc khi \u0111\u1EBFn
        \u0111\xE2y ch\u1EE9, ng\u01B0\u01A1i c\xF3 phi\u1EC1n tr\u1EDF l\u1EA1i
        tr\u1EA7n gian \u0111\u1EC3 b\u1ECDn ta gi\u1EBFt ng\u01B0\u01A1i r\u1ED3i
        m\u1EDBi quay l\u1EA1i kh\xF4ng?"
    - name: Sketon
      lines:
      - "\xD4ng n\xF3i b\xE2y gi\u1EDD t\xF4i l\xE0m sao?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "\u0110\u1EC3 ta gi\u1EA3i th\xEDch cho ng\u01B0\u1EDDi nghe, Sketon!"
      - "Krixim, b\u1EA1n c\u1EE7a ng\u01B0\u1EDDi \u0111\xE3 ch\u1EBFt, t\u1EE9c
        l\xE0 ch\u1EC9 c\xF2n ph\u1EA7n h\u1ED3n m\xE0 kh\xF4ng c\xF3 ph\u1EA7n th\xE2n
        x\xE1c."
      - "Th\xE2n x\xE1c v\u1ED1n l\xE0 v\u1EADt ch\u1EA5t \u0111\u01B0\u1EE3c h\u1ED9i
        t\u1EE5 v\xE0 k\u1EBFt tinh t\u1EEB n\u0103ng l\u01B0\u1EE3ng c\u1EE7a ph\u1EA7n
        h\u1ED3n c\xF3 tr\u01B0\u1EDBc."
      - "B\xE2y gi\u1EDD ng\u01B0\u01A1i gi\u1EA3i ph\xF3ng linh h\u1ED3n c\u1EE7a
        Krixim, th\xEC m\u1ECDi c\xF4 \u1EA5y c\u0169ng kh\xF4ng th\u1EC3 tr\u1EDF
        l\u1EA1i nh\u01B0 tr\u01B0\u1EDBc \u0111\xE2y, "
      - "kh\xF4ng th\u1EC3 l\xE0 m\u1ED9t ng\u01B0\u1EDDi b\u1EA1n nh\u01B0 ng\u01B0\u01A1i
        \u0111\u01B0\u1EE3c bi\u1EBFt, Sketon."
      - "B\u1EA3n ng\xE3 tr\u01B0\u1EDBc \u0111\xE2y kh\xF4ng c\xF2n, gi\u1EA3i ph\xF3ng
        ph\u1EA7n h\u1ED3n, cho d\xF9 t\xE1i t\u1EA1o l\u1EA1i th\xE2n x\xE1c, "
      - "Krixim th\u1EADm ch\xED c\xF2n kh\xF4ng nh\u1EDB \u0111\u01B0\u1EE3c ch\xEDnh
        m\xECnh nh\u01B0 tr\u01B0\u1EDBc khi ch\u1EBFt,"
      - "hu\u1ED1ng chi l\xE0..ng\u01B0\u01A1i, Sketon. "
      - "Cho n\xEAn m\u1ED9t m\xECnh ng\u01B0\u01A1i, kh\xF4ng c\xF3 ta, th\xEC m\u1ECDi
        chuy\u1EC7n kh\xF4ng th\xE0nh \u0111\xE2u anh b\u1EA1n \xE0!"
    - name: Sketon
      lines:
      - "Gi\u1EEF \xF4ng l\u1EA1i th\xEC ta \u0111\u01B0\u1EE3c g\xEC?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "N\xF3i chung ta kh\xF4ng mu\u1ED1n ch\u1EBFt, Sketon!"
      - "H\u1EA1, h\u1EA1 thanh ki\u1EBFm \u0111\xF3 xu\u1ED1ng r\u1ED3i b\xECnh
        t\u0129nh n\xF3i chuy\u1EC7n ch\xE0ng trai \xE0. "
      - "\u0110\xFAng r\u1ED3i, l\xE0 ch\xEDnh l\xE0 thanh ki\u1EBFm \u0111\xF3."
      - "Sketon, d\xF9 c\xF3 s\u1EE9c m\u1EA1nh phi th\u01B0\u1EDDng, c\u1EADu c\u0169ng
        ch\u1EC9 m\u1EDBi l\xE0 m\u1ED9t th\u1EB1ng nh\xF3c th\xF4i b\u1EA1n \xE0. "
      - "C\xF2n thanh ki\u1EBFm m\xE0 ng\u01B0\u01A1i \u0111ang c\u1EA7m, n\xF3 h\u1ED5ng
        t\u1EA7m th\u01B0\u1EDDng \u0111\xE2u."
      - "Thanh ki\u1EBFm m\xE0 ng\u01B0\u01A1i \u0111ang c\u1EA7m, n\xF3 h\u1ED5ng
        t\u1EA7m th\u01B0\u1EDDng \u0111\xE2u."
      - "N\xF3 \u0111\xE3 l\u1EF1a ch\u1ECDn ng\u01B0\u01A1i, m\u1ED9t ng\u01B0\u1EDDi
        anh h\xF9ng x\u1EE9ng \u0111\xE1ng, "
      - "ng\u01B0\u01A1i c\xF3 h\u1ED5 th\u1EB9n kh\xF4ng khi c\xE0ng ng\xE0y l\u1EA1i
        tr\u1EDF th\xE0nh k\u1EBB gi\u1EBFt ng\u01B0\u1EDDi kh\xF4ng g\u1EDBm tay"
      - "trong khi c\u1EA7m thanh ki\u1EBFm \u0111\xF3, Sketon?"
    - name: Sketon
      lines:
      - "Kh\xF4ng c\xF3 g\xEC l\xE0 h\u1ED5 th\u1EB9n khi ta thanh tr\u1EEBng l\u0169
        \xE1c qu\u1EF7 nh\u01B0 ng\u01B0\u01A1i!"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "M\u1EA5u ch\u1ED1t n\u1EB1m \u1EDF ch\u1ED7 \u0111\xF3, anh tr\u1EBB \u1EA1."
      - "Thanh ki\u1EBFm qu\xE1i qu\u1EF7 n\xE0y \u0111\xF2i h\u1ECFi r\u1EA5t cao. "
      - "Ng\u01B0\u1EDDi c\u1EA7m \u0111\u01B0\u1EE3c n\xF3 ph\u1EA3i Th\u1EADt m\u1EA1nh
        m\u1EBD, Th\u1EADt gan d\u1EA1, v\xE0 C\xF3 tr\xE1i tim n\u1ED3ng \u1EA5m
        bao la. "
      - "Ng\u01B0\u01A1i v\u1ED1n l\xE0 ng\u01B0\u1EDDi h\u1ED9i t\u1EE5 \u0111\u1EE7
        c\u1EA3 ba y\u1EBFu t\u1ED1 \u0111\xF3. "
      - "Nh\u01B0ng b\xE2y gi\u1EDD ng\u01B0\u01A1i l\u1EA1i l\xE0 M\u1ED9t ng\u01B0\u1EDDi
        m\u1EA5t \u0111i m\u1ED9t t\xECnh y\xEAu, ta n\xF3i c\xF3 ph\u1EA3i kh\xF4ng,
        Sketon..."
    - name: Sketon
      lines:
      - '...

'
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ch\u1EC9 c\u1EA7n m\u1EA5t \u0111i 1 trong 3 t\u1ED1 ch\u1EA5t m\xE0 thanh
        ki\u1EBFm y\xEAu c\u1EA7u, ng\u01B0\u1EDDi c\u1EA7m n\xF3 r\u1EA5t d\u1EC5
        b\u1ECB tha h\xF3a,"
      - "ng\u01B0\u01A1i c\xF3 th\u1EA5y ng\u01B0\u01A1i d\u1EA7n tr\u1EDF th\xE0nh
        1 ng\u01B0\u1EDDi d\u1EC5 n\xF3ng gi\u1EADn kh\xF4ng Sketon,"
      - "ta kh\xF4ng ngh\u0129 ng\u01B0\u01A1i b\u1ECB d\u1EADy th\xEC s\u1EDBm? "
      - "Kh\xF4ng ph\u1EA3i t\u1EF1 nhi\xEAn m\xE0 n\xF3 l\u1EA1i b\u1ECB phong \u1EA5n. "
      - "Kh\xF4ng ph\u1EA3i t\u1EF1 nhi\xEAn m\xE0 n\xF3 l\u1EA1i b\u1ECB phong \u1EA5n. "
    - name: Sketon
      lines:
      - "\xD4ng n\xF3i nhi\u1EC1u qu\xE1!"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - ...
      - "Ta h\xF4ng n\xF3i ng\u01B0\u01A1i gi\u1EBFt ta ch\u1EBFt"
      - "... Ta n\xF3i ti\u1EBFp,"
      - "Kh\xF4ng ph\u1EA3i t\u1EF1 nhi\xEAn m\xE0 n\xF3 l\u1EA1i b\u1ECB phong \u1EA5n. "
      - "S\u1EBD th\u1EBF n\xE0o n\u1EBFu m\u1ED9t k\u1EBB thi\u1EBFu \u0111i 1 trong
        3 ph\u1EA9m ch\u1EA5t \u0111\xF3 c\u1EA7m \u0111\u01B0\u1EE3c thanh ki\u1EBFm?"
      - "Cho n\xEAn ta \u0111\xFAng l\xE0 1 l\xE3o gi\xE0 h\u1ED3 \u0111\u1ED3, Sketon
        \xE0. \u0110\xFAng r\u1ED3i Sketon, l\xE0 n\xF3 \u0111\xF3 ch\xE0ng trai
        c\u1EE7a ta \xE0. "
      - "Ch\xEDnh l\xE0 Krixim, n\xF3 ch\xEDnh l\xE0 ch\xECa kh\xF3a cho m\u1ECDi
        v\u1EA5n \u0111\u1EC1."
      - "Ch\xEDnh l\xE0 Krixim, n\xF3 ch\xEDnh l\xE0 ch\xECa kh\xF3a cho m\u1ECDi
        v\u1EA5n \u0111\u1EC1."
    - name: Sketon
      lines:
      - "R\u1ED3i sao n\u1EEFa?"
    - name: Sketon
      lines:
      - "R\u1ED3i sao n\u1EEFa?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Thanh Ki\u1EBFm \u0111\xF3 l\xE0 c\u1EE7a Th\u1EE7y Th\u1EA7n Zera, ngu\u1ED3n
        ti\xEAn c\u1EE7a Krixim. Ta ngh\u0129 ngu\u1ED3n ti\xEAn \u0111\xF3 c\xF3
        trong Thanh Ki\u1EBFm."
      - "B\xE2y gi\u1EDD ta ch\u1EC9 c\u1EA7n g\u1EEDi linh h\u1ED3n c\u1EE7a Krixim
        v\xE0o thanh ki\u1EBFm th\xF4i, Sketon. "
      - "Ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng \u0111\xF3 s\u1EBD ph\u1EE5c h\u1ED3i
        t\u1EA5t c\u1EA3 k\xFD \u1EE9c cho Krixim, k\u1EC3 c\u1EA3 c\xE1c k\xFD \u1EE9c
        c\u1ED5 x\u01B0a, n\xF3i ng\u1EAFn g\u1ECDn l\xE0 v\u1EADy."
      - "L\xFAc \u0111\xF3 Krixim s\u1EBD tr\u1EDF l\u1EA1i l\xE0 ng\u01B0\u1EDDi
        b\u1EA1n c\u0169 c\u1EE7a c\u1EADu."
    - name: Sketon
      lines:
      - "T\xEAn \xE1c qu\u1EF7 kia, t\u1ED1t nh\u1EA5t \xF4ng \u0111\u1EEBng l\u1EEBa
        ta."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "N\u1EBFu c\xF3 chuy\u1EC7n g\xEC, ng\u01B0\u01A1i c\u1EE9 ch\u1EB7t \u0111\u1EA7u
        ta!"
    - name: Ego
      lines:
      - "\u0110ang n\xF3i g\xEC th\u1EBF, t\xEAn ng\u1ED1c n\xE0y!"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ego, h\xE3y \u0111\u1EC3 ta n\xF3i chuy\u1EC7n v\u1EDBi Sketon."
      - "D\xF9 g\xEC ng\u01B0\u01A1i c\u0169ng mu\u1ED1n gi\u1EBFt ta, v\xE0 m\u1ECDi
        chuy\u1EC7n ta \u0111\xE3 tr\xECnh b\xE0y v\u1EDBi ng\u01B0\u01A1i \u0111\u1EC1u
        l\xE0 s\u1EF1 th\u1EADt, "
      - "gi\u1EBFt ta tr\u01B0\u1EDBc th\xEC m\u1ECDi chuy\u1EC7n kh\xF4ng th\xE0nh
        ra g\xEC \u0111\xE2u c\u1EADu b\xE9 \xE0!"
    - name: Sketon
      lines:
      - "Kh\xF4ng ph\u1EA3i ng\u01B0\u01A1i n\xF3i n\u1EBFu ta gi\u1EBFt ng\u01B0\u01A1i
        th\xEC s\u1EBD tr\u1EDF th\xE0nh ng\u01B0\u01A1i sao, t\xEAn kh\u1ED1n gian
        x\u1EA3o!"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Nh\u01B0ng gi\u1EBFt ta th\xEC ta h\u1EBFt, Sketon. Ta l\xE0 1 v\u1ECB th\u1EA7n
        c\xF3 tr\xE1ch nhi\u1EC7m v\u1EDBi cu\u1ED9c s\u1ED1ng c\u1EE7a b\u1EA3n
        th\xE2n."
      - "Ng\u01B0\u01A1i ph\u1EA3i tin ta!"
    - name: Sketon
      lines:
      - "Nh\u01B0 l\u1EDDi \xF4ng n\xF3i, th\xEC \xF4ng s\u1EBD cho Krixim s\u1ED1ng
        l\u1EA1i trong thanh ki\u1EBFm n\xE0y \xE0?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "\u0110\xFAng v\u1EADy! C\xF4 \u1EA5y c\xF3 th\u1EC3 tho\xE1t x\xE1c kh\u1ECFi
        thanh ki\u1EBFm v\xE0 bi\u1EBFn th\xE0nh nh\xE2n d\u1EA1ng ch\u1EA1y \u0111i
        ch\u01A1i v\u1EDBi c\u1EADu n\u1EBFu c\u1EADu mu\u1ED1n,"
      - "v\xEC ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng c\u1EE7a thanh ki\u1EBFm r\u1EA5t
        linh thi\xEAng."
      - "N\u1EBFu c\u1EADu lu\xF4n gi\u1EEF thanh ki\u1EBFm b\xEAn m\xECnh, c\xF4
        \u1EA5y s\u1EBD lu\xF4n \u1EDF b\xEAn c\u1EADu."
    - name: Sketon
      lines:
      - "\u2026"
      - "\u0110\u01B0\u1EE3c!"
      - "Ta tin ng\u01B0\u01A1i l\u1EA7n n\xE0y. Nh\u01B0ng ta c\u0169ng s\u1EB5n
        s\xE0ng tr\u1EDF th\xE0nh Th\u1EA7n Ch\u1EBFt n\u1EBFu ng\u01B0\u01A1i gi\u1EDF
        tr\xF2."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ng\u01B0\u01A1i th\u1EA5y \u0111\u1EA5y, m\u1ED9t m\u1EB7t, thanh ki\u1EBFm
        \u0111\xE3 m\u1EDF r\u1ED9ng v\u1ED1n t\u1EEB v\xE0 gi\xFAp ng\u01B0\u01A1i
        c\xF3 kh\xED ch\u1EA5t h\u01A1n."
      - "Sketon. R\u1ED3i ng\u01B0\u01A1i s\u1EBD mu\u1ED1n tin ta th\xEAm nhi\u1EC1u
        l\u1EA7n n\u1EEFa \u0111\u1EA5y!"
      - "Nh\u01B0ng c\u1EADu ph\u1EA3i ph\u1ED1i h\u1EE3p v\u1EDBi ta."
      - "Trong khi ta chuy\u1EC3n linh h\u1ED3n c\u1EE7a Krixim sang thanh ki\u1EBFm,
        thanh ki\u1EBFm s\u1EBD ph\u1EA3n \u1EE9ng v\xEC 1 ch\xFAt xung \u0111\u1ED9t
        n\u0103ng l\u01B0\u01A1ng."
      - "C\u1EADu l\xE0 ch\u1EE7 c\u1EE7a thanh ki\u1EBFm, n\xEAn c\u1EADu c\xF3
        th\u1EC3 ki\u1EC3m so\xE1t n\xF3. "
      - "H\xE3y ph\u1ED1i h\u1EE3p v\u1EDBi ta \u0111\u1EC3 h\u1EE3p nh\u1EA5t n\u0103ng
        l\u01B0\u1EE3ng gi\u1EEFa Krixim v\xE0 Thanh Ki\u1EBFm!"
  talkButton: {fileID: 8501491540886582705}
  dialogueDelay: 0
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 614518909}
