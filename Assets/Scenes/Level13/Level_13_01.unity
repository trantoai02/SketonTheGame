--- !u!114 &1367233681
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1367233679}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d3c5e169fdd9de4aa7a43fe96442e99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eventBeforeTriggerDialogue:
    m_PersistentCalls:
      m_Calls: []
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 512613883}
        m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
        m_MethodName: SetActive
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 1
        m_CallState: 2
  dialogueList:
    dialogues:
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "\u0110\xFAng r\u1ED3i! Ch\xFAng ta c\xF3 th\u1EC3 d\xF9ng v\u1EADt n\xE0y
        \u0111\u1EC3 chi\u1EBFt l\u1ECDc linh h\u1ED3n c\u1EE7a Krixim t\u1EEB b\u1EC3
        linh h\u1ED3n. "
      - "C\xF2n n\u1EEFa, c\xF2n n\u1EEFa..."
      - "Linh h\u1ED3n Krixim c\u1EA7n th\u1EC3 x\xE1c. T\xF4i s\u1EBD cho Krixim
        v\xE0o Thanh Ki\u1EBFm."
    - name: Sketon
      lines:
      - "C\xE1i g\xEC!? Kh\xF4ng \u0111\u01B0\u1EE3c!"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ta c\u0169ng h\u1EBFt c\xE1ch r\u1ED3i, Sketon! Ta \u0111\u1EE7 th\xF4ng
        th\xE1i \u0111\u1EC3 bi\u1EBFt Thanh Ki\u1EBFm \u0111\xF3 c\xF3 th\u1EC3
        l\u01B0u gi\u1EEF linh h\u1ED3n c\u1EE7a Krixim. "
      - "\u1EDE trong Thanh Ki\u1EBFm \u0111\xF3, Krixim s\u1EBD kh\xF4ng kh\xE1c
        g\xEC nh\u01B0 l\xFAc tr\u01B0\u1EDBc,"
      - "ngo\u1EA1i tr\u1EEB vi\u1EC7c b\xE2y gi\u1EDD tr\u1EDF th\xE0nh m\u1ED9t
        Thanh Ki\u1EBFm. "
      - "Tin t\u1ED1t l\xE0, c\xF4 b\xE9 s\u1EBD lu\xF4n \u1EDF b\xEAn c\u1EA1nh
        ng\u01B0\u01A1i."
    - name: Sketon
      lines:
      - ...
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - ...
      - Ha!?
    - name: Sketon
      lines:
      - "\u0110\u01B0\u1EE3c!"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "R\u1ED3i!"
      - "C\xF3 \u0111i\u1EC1u.. m\xF3n ph\xE9p n\xE0y \u0111\xE3 l\xE2u r\u1ED3i
        ta kh\xF4ng d\xF9ng \u0111\u1EBFn. Ta c\u1EA7n ng\u01B0\u01A1i gi\xFAp \u0111\u1EE1,
        Sketon."
    - name: Sketon
      lines:
      - "L\xE0m sao ta c\xF3 th\u1EC3 tin ng\u01B0\u01A1i?\r\n"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "M\u1ECDi chuy\u1EC7n ta \u0111\xE3 tr\xECnh b\xE0y v\u1EDBi ng\u01B0\u01A1i
        \u0111\u1EC1u l\xE0 s\u1EF1 th\u1EADt. "
      - "N\u1EBFu m\u1ECDi chuy\u1EC7n kh\xF4ng \u0111\u01B0\u1EE3c nh\u01B0 ta n\xF3i,
        l\xFAc \u0111\xF3 ng\u01B0\u01A1i mu\u1ED1n ch\u1EB7t c\xE1i \u0111\u1EA7u
        ta c\u0169ng kh\xF4ng mu\u1ED9n."
    - name: Sketon
      lines:
      - "Gi\u1EBFt ng\u01B0\u01A1i th\xEC ta s\u1EBD \u0111\u01B0\u1EE3c g\xEC ch\u1EE9,
        ta s\u1EBD tr\u1EDF th\xE0nh T\u1EED Th\u1EA7n m\xE0."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ng\u01B0\u01A1i c\xF2n c\u1EA7n th\u1EE9 g\xEC n\u1EEFa sao, ngo\xE0i Krixim?"
      - "Nh\u01B0ng ta ch\u1EBFt l\xE0 ta h\u1EBFt, Sketon."
      - "Ta l\xE0 1 v\u1ECB th\u1EA7n c\xF3 tr\xE1ch nhi\u1EC7m v\u1EDBi cu\u1ED9c
        s\u1ED1ng c\u1EE7a b\u1EA3n th\xE2n."
    - name: Sketon
      lines:
      - "B\xE2y gi\u1EDD ng\u01B0\u01A1i ta c\u1EA7n l\xE0m g\xEC?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "T\u1ED1t l\u1EAFm, Sketon, r\u1ED3i ng\u01B0\u01A1i s\u1EBD mu\u1ED1n tin
        ta th\xEAm nhi\u1EC1u l\u1EA7n n\u1EEFa \u0111\u1EA5y!"
      - "H\xE3y ph\u1ED1i h\u1EE3p v\u1EDBi ta \u0111\u1EC3 tinh l\u1ECDc n\u0103ng
        l\u01B0\u1EE3ng c\u1EE7a Krixim t\u1EEB B\u1EC3 Linh H\u1ED3n!"
  talkButton: {fileID: 1093948667}
  dialogueDelay: 0
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 614518909}
