--- !u!114 &1985136946
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1985136944}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d3c5e169fdd9de4aa7a43fe96442e99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  eventBeforeTriggerDialogue:
    m_PersistentCalls:
      m_Calls: []
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
  dialogueList:
    dialogues:
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ch\u1EBFt ti\u1EC7t, c\xE1i qu\xE1i g\xEC v\u1EADy!!? Con ch\xF3 \u0111\xF3
        l\u1EA5y \u0111i tinh th\u1EC3 linh h\u1ED3n c\u1EE7a Krixim r\u1ED3i. "
    - name: 'Ego '
      lines:
      - "\xD4ng \u0111\xE1ng ra n\xEAn \u0111\u01B0a t\u1EADn tay t\xF4i th\xEC h\u01A1n."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Kh\u1EC9 th\u1EADt, \u0111\xE1ng ra ta ph\u1EA3i l\xE0m nh\u01B0 th\u1EBF!"
      - "Sketon, Sketon, b\xECnh t\u0129nh! Ta bi\u1EBFt b\u1ECDn ch\xF3 \u0111\xF3,
        \u0111\xF3 l\xE0 l\u0169 ch\xF3 c\u1EE7a Era, th\u1EA7n gi\xF3 x\u1EE9 M\xF9
        M\xE2y. "
    - name: Ego
      lines:
      - "Era? B\xE0 \u1EA5y l\u1EA5y tinh th\u1EC3 c\u1EE7a Krixim l\xE0m g\xEC?\r\n"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - ...
      - "Ch\u1EAFc b\xE0 \u1EA5y mu\u1ED1n c\u1EADu \u0111\u1EBFn \u0111\xF3, Sketon."
    - name: Sketon
      lines:
      - "Era? B\xE0 \u1EA5y c\u0169ng l\xE0 ng\u01B0\u1EDDi x\u1EA5u nh\u01B0 ng\u01B0\u01A1i
        \xE0?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Kh\xF4ng ph\u1EA3i, kh\xF4ng ph\u1EA3i, Sketon.. b\xE0 \u1EA5y kh\xF4ng
        ph\u1EA3i ng\u01B0\u1EDDi x\u1EA5u... "
    - name: Sketon
      lines:
      - "\u0110i\u1EC1u n\xE0y c\xF3 li\xEAn quan \u0111\u1EBFn  Th\u1EA7n R\u1EEBng
        kh\xF4ng?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "\u0110\xF3 l\xE0 nghi\u1EC7p \xE1c c\u1EE7a h\u1EAFn."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "V\u0169 tr\u1EE5 n\xE0y, m\u1ECDi th\u1EE9 trong n\xF3 \u0111\u1EC1u t\u1ED3n
        t\u1EA1i v\xE0 ph\xE1t tri\u1EC3n theo quy lu\u1EADt Sinh - Di\u1EC7t c\xE2n
        b\u1EB1ng. "
      - "S\u1EF1 s\u1ED1ng v\xE0 c\xE1i ch\u1EBFt v\u1ED1n l\xE0 s\u1EF1 c\xE2n b\u1EB1ng
        ho\xE0n h\u1EA3o, v\u1EEBa \u0111\u1ED1i ngh\u1ECBch l\u1EA1i v\u1EEBa b\u1ED5
        sung cho nhau. "
      - "N\u1EBFu m\u1EA5t \u0111i m\u1ED9t trong hai y\u1EBFu t\u1ED1 c\u1EE7a s\u1EF1
        c\xE2n b\u1EB1ng \u1EA5y, "
      - "s\u1EF1 s\u1EE5p \u0111\u1ED5 trong chu\u1ED7i c\u1EA5u tr\xFAc v\xF4 t\u1EADn
        c\u1EE7a v\u0169 tr\u1EE5 s\u1EBD b\u1EAFt \u0111\u1EA7u di\u1EC5n ra. "
      - "V\xE0 t\xEAn Th\u1EA7n R\u1EEBng v\u1EDBi c\xE1i \u1EA3o t\u01B0\u1EDFng
        b\u1EA5t t\u1EED c\u1EE7a h\u1EAFn s\u1EBD ch\u1EA5m d\u1EE9t s\u1EF1 c\xE2n
        b\u1EB1ng v\u1ED1n c\xF3 trong v\u0169 tr\u1EE5. "
      - "H\u1EAFn mu\u1ED1n gi\u1EBFt ta \u0111\u1EC3 gi\xE0nh l\u1EA5y s\u1EF1 b\u1EA5t
        t\u1EED cho mu\xF4n lo\xE0i."
    - name: Sketon
      lines:
      - "N\u1EBFu \xF4ng \u1EA5y gi\u1EBFt \xF4ng, sao \u1ED5ng kh\xF4ng bi\u1EBFn
        th\xE0nh \xF4ng nh\u01B0 l\u1EDDi nguy\u1EC1n?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Xin l\u1ED7i Sketon, l\u1EDDi nguy\u1EC1n \u0111\xF3 do ta b\u1ECBa ra.\r\n"
    - name: Sketon
      lines:
      - "\xD4ng c\xF3 v\u1EBB \u0111\xE1ng tin h\u01A1n r\u1ED3i \u0111\u1EA5y!"
      - "Ch\u1EB3ng ph\u1EA3i \xF4ng c\u0169ng s\u1EE3 ch\u1EBFt sao? N\u1EBFu kh\xF4ng
        ch\u1EBFt ch\u1EB3ng ph\u1EA3i t\u1ED1t h\u01A1n sao?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ph\u1EA3i, ta s\u1EE3 ch\u1EBFt. C\u0169ng ph\u1EA3i xem ng\u01B0\u01A1i
        \u0111\u1ECBnh ngh\u0129a th\u1EBF n\xE0o l\xE0 c\xE1i ch\u1EBFt v\xE0 s\u1EF1
        s\u1ED1ng,"
      - "s\u1EF1 s\u1ED1ng c\u1EE7a ta l\xE0 hi\u1EC7n th\xE2n cho c\xE1i ch\u1EBFt,
        c\u01A1 th\u1EC3 c\u1EE7a ta to\xE0n l\xE0 c\xE1i ch\u1EBFt."
      - "Nh\u01B0ng m\xE0 n\xF3i r\u1ED9ng ra cho \u0111\xFAng, s\u1ED1ng v\xE0 ch\u1EBFt
        l\xE0 nh\u1EEFng con s\xF3ng lu\xE2n phi\xEAn h\u1ED7 tr\u1EE3 nhau trong
        d\xF2ng ch\u1EA3y c\u1EE7a v\u0169 tr\u1EE5, "
      - "ch\u01B0a bao gi\u1EDD thi\u1EBFu m\u1ED9t trong hai."
      - "Ta \u0111\xE3 b\u1EA5t l\u1EF1c v\u1EDBi s\u1EE9c m\u1EA1nh c\u1EE7a t\xEAn
        Th\u1EA7n R\u1EEBng."
      - "Nh\u01B0ng v\u0169 tr\u1EE5 th\xEC kh\xF4ng, ng\xE0i \u1EA5y \u0111\xE3
        g\u1EEDi t\u1EDBi m\u1ED9t h\u1EA1t gi\u1ED1ng \u0111\u1EC3 t\xE1i c\u1EA5u
        tr\xFAc s\u1EF1 s\u1EE5p \u0111\u1ED5 m\xE0 t\xEAn Th\u1EA7n R\u1EEBng g\xE2y
        ra. "
      - "Ta cho r\u1EB1ng Sketon, ng\u01B0\u01A1i ch\xEDnh l\xE0 h\u1EA1t gi\u1ED1ng
        m\xE0 ng\xE0i \u1EA5y g\u1EEDi t\u1EDBi."
    - name: Sketon
      lines:
      - "Ng\u01B0\u01A1i mu\u1ED1n n\xF3i \u0111\u1EBFn ai khi g\u1ECDi l\xE0 Ng\xE0i
        \u1EA5y?"
    - name: "Th\u1EA7n R\u1EEBng"
      lines:
      - "V\u0169 tr\u1EE5 n\xE0y l\xE0 hi\u1EC7n th\xE2n c\u1EE7a Ng\xE0i. "
    - name: Sketon
      lines:
      - "N\xF3i nh\u01B0 v\u1EADy, ch\xFAng ta \u0111ang s\u1ED1ng b\xEAn trong c\u01A1
        th\u1EC3 c\u1EE7a \xF4ng \u1EA5y sao?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "C\u0169ng t\xF9y c\xE1ch ng\u01B0\u01A1i hi\u1EC3u mu\u1ED1n hi\u1EC3u,
        ch\xFAng ta l\xE0 nh\u1EEFng ng\xF3n tay tr\xEAn c\u01A1 th\u1EC3 \xF4ng
        \u1EA5y."
    - name: Sketon
      lines:
      - "Xem ra \xF4ng \u1EA5y c\xF3 nhi\u1EC1u ng\xF3n tay th\u1EADt \u0111\u1EA5y.
        \xD4ng c\xF3 v\u1EBB r\u1EA5t hi\u1EC3u v\u1EC1 v\u0169 tr\u1EE5."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ch\u1EC9 l\xE0 kinh nghi\u1EC7m s\u1ED1ng th\xF4i, kh\xF4ng c\xF3 g\xEC
        \u0111\xE2u!"
    - name: Ego
      lines:
      - ...
    - name: Sketon
      lines:
      - "Th\u1EA7n R\u1EEBng \u0111\xE3 l\xE0m g\xE2y ra s\u1EF1 s\u1EE5p \u0111\u1ED5
        g\xEC?"
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "B\u1ECDn qu\u1EF7 tr\u1EA7n gian, ng\u01B0\u01A1i th\u1EA5y \u0111\u1EA5y.
        Qu\u1EF7 \u0111\u1ECBa ng\u1EE5c v\u1ED1n kh\xF4ng bao gi\u1EDD c\xF3 th\u1EC3
        l\xEAn \u0111\u01B0\u1EE3c tr\xEAn \u1EA5y. "
      - "B\u1ECDn qu\u1EF7 tr\u1EA7n gian l\xE0 th\xE2y ma b\u1ECB k\u1EB9t gi\u1EEFa
        s\u1EF1 s\u1ED1ng v\xE0 c\xE1i ch\u1EBFt b\u1EDFi c\xE1c th\xED nghi\u1EC7m
        c\u1EE7a t\xEAn Th\u1EA7n R\u1EEBng. "
      - "Ch\xFAng \u0111\xE3 van xin ta gi\u1EA3i tho\xE1t cho ch\xFAng \u0111\u1EA5y. "
      - "V\xE0 ta \u0111\xE3 ch\u1EA5p nh\u1EADn l\u1EDDi th\u1EC9nh c\u1EA7u c\u1EE7a
        b\u1ECDn ch\xFAng,"
      - "ch\xFAng s\u1EBD \u0111\u01B0\u1EE3c gi\u1EA3i tho\xE1t ch\u1EEBng n\xE0o
        t\xEAn Th\u1EA7n R\u1EEBng \u1EA5y ch\u1EBFt \u0111i."
    - name: Sketon
      lines:
      - "V\u1EADy ra \u0111\xF3 l\xE0 cu\u1ED9c chi\u1EBFn c\u1EE7a c\xE1c \xF4ng."
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - "Ng\u01B0\u01A1i n\xF3i ph\u1EA3i, l\xE0 cu\u1ED9c chi\u1EBFn c\u1EE7a b\u1ECDn
        ta."
      - "Nh\u01B0ng s\u1EBD \u0111\u1EBFn l\xFAc ng\u01B0\u01A1i th\u1EA5y m\xECnh
        c\u0169ng c\u1EA7n ph\u1EA3i ra tay, v\u01B0\u1EE3t l\xEAn tr\xEAn c\u1EA3
        t\xECnh y\xEAu c\xE1 nh\xE2n. "
    - name: "Th\u1EA7n Ch\u1EBFt"
      lines:
      - ...
      - "Gi\u1EDD, ta m\u1EDF c\u1ED5ng cho ng\u01B0\u01A1i l\xEAn x\u1EE9 M\xF9
        M\xE2y, t\xECm ng\u01B0\u1EDDi b\u1EA1n c\u1EE7a ng\u01B0\u01A1i."
  talkButton: {fileID: 1487881508}
  dialogueDelay: 0
  itemPrefab: {fileID: 0}
  objToMoveToPlayer: {fileID: 0}
  positionSetterForPlayer: {fileID: 614518909}
